# MiMo API Configuration
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL_PRO=mimo-v2.5-pro
MIMO_MODEL_LITE=mimo-v2.5-lite

# Blockchain RPC Endpoints
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed1.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# External APIs
ETHERSCAN_API_KEY=your_etherscan_key
DEFILLAMA_BASE_URL=https://api.llama.fi
GOPLUS_API_KEY=your_goplus_key

# Database
DATABASE_URL=postgresql://guardian:password@localhost:5432/defi_guardian
REDIS_URL=redis://localhost:6379/0

# Alerts
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALERT_CHAT_ID=your_chat_id

# Agent Configuration
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT=120
LOG_LEVEL=INFO
